# Canonical origin used for metadata, canonical URLs, sitemap, robots and OG images.
# Set this in production (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable GA.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (content="..." value). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form delivery via Resend (https://resend.com). When unset, the form
# falls back to the reference behaviour: it composes the email in the visitor's mail app.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "D.zilla <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Inbox that receives enquiries. Defaults to the address in src/content/site.ts.
CONTACT_TO_EMAIL=
